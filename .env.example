# Adversarial Plan Review — local environment variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# ----------------------------------------------------------------------------
# Reviewer transport selection
# ----------------------------------------------------------------------------

# Optional: explicit transport override. When unset (the default), the skill
# auto-detects in this order: OpenAI key set → openai; `claude` on PATH →
# claude; `codex` on PATH → codex.
# Valid values: openai | codex | claude   (anything else is a hard error —
# `anthropic` is NOT an alias for claude)
# Note: an EXPLICIT openai selection also disables the quota fallback — an
# out-of-credit error surfaces to you instead of switching to claude.
# ADVERSARIAL_TRANSPORT=openai

# ----------------------------------------------------------------------------
# OpenAI Responses API path (recommended; enables severity tagging)
# ----------------------------------------------------------------------------

# Required when transport=openai (or auto-detected as openai).
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional: override the reviewer model. Defaults to gpt-5.6-sol (July 2026
# flagship — deepest reasoning tier of the gpt-5.6 family). Other valid options:
#   gpt-5.6-terra — balanced tier; half the cost of sol
#   gpt-5.6-luna  — fastest/cheapest tier; reduced accuracy
#   gpt-5.5       — previous flagship; v2 launch default
#   gpt-5.5-pro   — higher accuracy at ~6x sol cost; for difficult plans
OPENAI_REVIEWER_MODEL=gpt-5.6-sol

# Optional: max tokens per reviewer response. Defaults to 8000.
# Raise for very large plans; lower to cap per-round cost.
OPENAI_MAX_TOKENS=8000

# Optional: pricing override (USD per 1M tokens) for orgs on non-default tiers.
# When BOTH are set, they override the built-in rate table in cost_tracker.py
# for the OpenAI rows only — they never re-price the claude-* rows.
# OPENAI_INPUT_USD_PER_1M=5.0
# OPENAI_OUTPUT_USD_PER_1M=30.0

# ----------------------------------------------------------------------------
# Claude Code CLI path (auto-fallback; repo-verifying reviewer)
# ----------------------------------------------------------------------------
# No API key: the transport shells out to `claude -p` and uses your Claude Code
# login. Cost comes straight off the result envelope's total_cost_usd.
#
# The subprocess is contained by FLAGS, not prose: --setting-sources ""
# (no inherited permission mode / hooks / CLAUDE.md priors), --strict-mcp-config,
# --tools + --allowedTools, and a --disallowedTools write/git/rm floor.
# See README.md → "Containment contract".

# Optional: reviewer model. CLI alias (opus | sonnet | fable) or a full model
# id. Defaults to opus; the resolved id is what gets recorded.
# CLAUDE_REVIEWER_MODEL=opus

# Optional: the tool floor, passed to BOTH --tools and --allowedTools.
# Default enables repo probes. Use the read-only preset below to remove the
# only write primitive (Bash) entirely.
# ADVERSARIAL_CLAUDE_TOOLS=Read,Grep,Glob,Bash
# ADVERSARIAL_CLAUDE_TOOLS=Read,Grep,Glob

# Optional: wall-clock timeout for one claude round, in seconds. Default 1200.
# ADVERSARIAL_CLAUDE_TIMEOUT_S=1200

# Optional: --max-turns cap. Default 120 (2x the max observed in design probes).
# Exhausting it truncates the round; that's classified transient (one retry).
# ADVERSARIAL_CLAUDE_MAX_TURNS=120

# Optional: --max-budget-usd cap for one claude round. Default 5.0.
# ADVERSARIAL_CLAUDE_MAX_BUDGET_USD=5.0

# ----------------------------------------------------------------------------
# Loop control (Phase 1+2: tracked but not enforced; Phase 4: enforced)
# ----------------------------------------------------------------------------

# Hard ceiling on review rounds. Defaults to loop_state.DEFAULT_MAX_ROUNDS (5).
# Hitting it is a budget checkpoint rather than a hard stop — with items still
# open the soft-block asks whether to continue, defer, or accept the risk.
# Raise for large/architectural plans.
ADVERSARIAL_MAX_ROUNDS=5

# Per-run cost cap in USD. Tracked from Phase 1; pause-on-exceed gating
# lands in Phase 4 (see plans/v2-plan.md §5.4).
ADVERSARIAL_MAX_COST_USD=5.0

# Plan-bloat detection (Phase 4). Trigger thresholds:
#   THRESHOLD = fractional growth (0.20 = 20%)
#   WINDOW    = number of rounds to look back over
# Together: warn if plan grew >THRESHOLD over the last WINDOW rounds without
# new high-severity findings. See §5.5.
ADVERSARIAL_BLOAT_THRESHOLD=0.20
ADVERSARIAL_BLOAT_WINDOW=3
